# Copy to .env and fill in. Every value here is read and validated by src/env.ts; the app
# refuses to start on anything missing or malformed.

APP_ENV=development
PORT=8740
TIME_ZONE=Europe/Budapest
# Relative paths resolve from the working directory.
DATA_DIR=./data
BACKUP_DIR=./backups
LOG_LEVEL=info

MAIL_POLL_MINUTES=60
BANK_POLL_HOURS=6

# Gmail: IMAP on, 2-step verification on, then an app password (Google Account → Security).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=
# Senders whose mail is read: domains or full addresses, comma separated.
# Never a shared invoicing platform (szamlazz.hu, billingo.hu, ...): every customer of such a
# platform gets a valid DKIM signature for its domain.
MAIL_SENDERS=mvm.hu,mvmnext.hu,telekom.hu
MAIL_TRUSTED_AUTHSERV=mx.google.com
# Addresses your bills are sent to (default: IMAP_USER). Add aliases that forward here.
# MAIL_RECIPIENTS=you@gmail.com,you@example.hu
MAIL_LOOKBACK_DAYS=180
# Optional: your own payer id per supplier (domain=payer-id, repeat a supplier for several ids).
# When set, a bill whose payer id is not listed for its sender goes to the manual-review inbox
# instead of becoming a bill; when unset, every verified bill is accepted.
# MAIL_PAYER_IDS=mvm.hu=123456789,telekom.hu=987654321

# local = any OpenAI-compatible server (llama.cpp); gemini = paid Gemini API key.
EXTRACTOR=local
LOCAL_LLM_URL=http://127.0.0.1:8002/v1
LOCAL_LLM_MODEL=qwen3-14b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EXTRACT_MAX_ATTEMPTS=4

# Enable Banking: Control Panel → API applications → new production app, then
# "Activate by linking accounts" (restricted mode, free, own accounts only).
EB_APP_ID=
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# Must be whitelisted in the Enable Banking app.
EB_REDIRECT_URL=http://localhost:8740/bank/callback
BANK_LOOKBACK_DAYS=90

BACKUP_ENABLED=true
BACKUP_KEEP=14
