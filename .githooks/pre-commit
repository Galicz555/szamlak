#!/bin/sh
# Secrets live next to this repo (.env, the Enable Banking key); refuse any commit that carries one.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (see mise.toml); refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
